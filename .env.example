# GEMINI_API_KEY: Required for server-side Gemini AI calls (SmartReport AI,
# Voice Transcription/Structuring, Duplicate Intelligence, and Authority Prioritization).
# Obtain from Google AI Studio and set in your local .env or Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret key used to sign HMAC authentication tokens.
# Recommended in production so user sessions persist across server restarts.
# If omitted in local development, an ephemeral 256-bit secret is generated on startup.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING"

# APP_URL: Public base URL where the application is hosted.
APP_URL="http://localhost:3000"
